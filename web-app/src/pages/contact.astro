---
import BaseLayout from '../layouts/BaseLayout.astro';
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'FilterSpec Direct';
---
<BaseLayout title={`Contact & Spec Corrections | ${siteName}`} description="Report a model update or compatibility correction." canonicalPath="/contact/">
  <article class="card">
    <h1>Contact &amp; Specification Corrections</h1>
    <p>Spotted a new model revision or part number update? Send the device brand, model sticker code, and ASIN reference to our editorial desk:</p>
    <p><strong>Email:</strong> puryonodedi@gmail.com</p>
  </article>
</BaseLayout>
