---
interface Props {
  brand: string;
  model: string;
  partCode: string | null;
  dimensions: {
    length_in: number;
    width_in: number;
    height_in: number;
  } | null;
}

const { brand, model, partCode, dimensions } = Astro.props;
---

{dimensions && dimensions.length_in > 0 && (
  <figure class="blueprint-box" aria-label={`Technical dimension diagram for ${brand} ${model} filter`}>
    <div class="blueprint-header">
      <span class="bp-badge">VERIFIED SPEC BLUEPRINT</span>
      <span class="bp-code">{partCode ? `Part #${partCode}` : `${brand} ${model}`}</span>
    </div>
    <svg viewBox="0 0 420 190" width="100%" height="190" role="img" aria-labelledby="svg-title">
      <title id="svg-title">{brand} {model} Replacement Filter Dimensions ({dimensions.length_in}" x {dimensions.width_in}" x {dimensions.height_in}")</title>
      <defs>
        <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e2e8f0" stroke-width="0.7" />
        </pattern>
      </defs>
      <rect width="420" height="190" fill="url(#grid)" rx="6" />

      {/* Isometric Technical Box Representation */}
      <polygon points="130,55 240,55 275,35 165,35" fill="#dbeafe" stroke="#1d4ed8" stroke-width="1.8" />
      <rect x="130" y="55" width="110" height="95" fill="#eff6ff" stroke="#1d4ed8" stroke-width="1.8" />
      <polygon points="240,55 275,35 275,130 240,150" fill="#bfdbfe" stroke="#1d4ed8" stroke-width="1.8" />

      {/* Dimension Lines */}
      <line x1="112" y1="55" x2="112" y2="150" stroke="#0f172a" stroke-width="1.4" />
      <line x1="107" y1="55" x2="117" y2="55" stroke="#0f172a" stroke-width="1.4" />
      <line x1="107" y1="150" x2="117" y2="150" stroke="#0f172a" stroke-width="1.4" />
      <text x="102" y="106" text-anchor="end" font-family="monospace" font-size="12" font-weight="bold" fill="#0f172a">
        H: {dimensions.height_in}"
      </text>

      <line x1="130" y1="166" x2="240" y2="166" stroke="#0f172a" stroke-width="1.4" />
      <line x1="130" y1="161" x2="130" y2="171" stroke="#0f172a" stroke-width="1.4" />
      <line x1="240" y1="161" x2="240" y2="171" stroke="#0f172a" stroke-width="1.4" />
      <text x="185" y="182" text-anchor="middle" font-family="monospace" font-size="12" font-weight="bold" fill="#0f172a">
        L: {dimensions.length_in}"
      </text>

      <line x1="252" y1="158" x2="287" y2="138" stroke="#0f172a" stroke-width="1.4" />
      <text x="294" y="152" font-family="monospace" font-size="12" font-weight="bold" fill="#0f172a">
        W: {dimensions.width_in}"
      </text>
    </svg>
    <figcaption>
      Physical footprint extracted from verified product specifications: <strong>{dimensions.length_in}" L × {dimensions.width_in}" W × {dimensions.height_in}" H</strong>.
    </figcaption>
  </figure>
)}